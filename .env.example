# Leave empty to return signed GET URLs for private objects.
S3_PUBLIC_URL=
S3_PRESIGN_TTL=1h
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

GCL_APP_NAME=
